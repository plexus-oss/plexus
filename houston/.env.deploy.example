# .env.deploy — production secrets for plexus-alert-service on Fly.
#
# Copy to `.env.deploy`, fill in the real values, then apply with:
#     ./deploy.sh secrets
#
# `.env.deploy` is in .gitignore. DO NOT COMMIT the filled copy. Rotate
# the internal secret if this file ever leaks.
#
# Everything here becomes a `flyctl secrets set` entry, so value-is-
# literal (no shell expansion, no substitution).

# Redis — private-network address, no auth. Same instance the gateway
# writes to. See gateway/ARCHITECTURE.md for the trust model.
REDIS_URL=redis.internal:6379

# Next.js base URL. No trailing slash. Used for both:
#   GET  /api/internal/alerts/rules/all        (bootstrap)
#   POST /api/internal/alerts/transitions      (state changes)
PLEXUS_API_URL=https://app.plexus.example

# Shared secret for x-internal-secret header. MUST be identical to
# PLEXUS_INTERNAL_SECRET on the Next.js side. Rotate both together.
PLEXUS_INTERNAL_SECRET=change-me

# ClickHouse sink REMOVED in commit 3bf7eb4 ("stop writing to ch").
# PLEXUS_CLICKHOUSE_DSN is no longer read by any code — do not set it.
