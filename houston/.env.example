# Alert Service — local development
# Copy to .env and adjust as needed.

ALERTD_MODE=dev
ALERTD_ADDR=:8081
LOG_LEVEL=info

# Redis (same instance as gateway)
REDIS_URL=localhost:6379

# Next.js API (for rule bootstrap and transition POSTs)
PLEXUS_API_URL=http://localhost:3000
PLEXUS_INTERNAL_SECRET=

# ClickHouse sink — REMOVED in commit 3bf7eb4 ("stop writing to ch").
# ALERTD_CH_ENABLED and PLEXUS_CLICKHOUSE_DSN are no longer read by any
# code; kept here only as a note. Do not expect a ClickHouse write path.

# Consumer tuning
# ALERTD_CONSUMER_GROUP=alerts
# ALERTD_CONSUMER_NAME=alerts-01

# Distribution decay (0.01 = negligible after ~500 points)
# ALERTD_DISTRIBUTION_ALPHA=0.01

# On-disk cache of the last-known-good rule set. Used as a bootstrap
# fallback when PLEXUS_API_URL is unreachable at startup. If neither the
# API nor this cache yield rules, the service exits non-zero rather than
# silently running with no rules. In prod on Fly, point this at a
# mounted volume so the cache survives machine restarts.
# ALERTD_RULES_CACHE_PATH=./rules-cache.json
