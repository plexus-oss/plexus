{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:up": "./scripts/db/up.sh",
    "db:seed": "./scripts/db/seed.sh",
    "db:down": "docker compose stop postgres",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:baseline": "tsx scripts/db/baseline.ts",
    "db:pull": "drizzle-kit pull",
    "db:bundle-migrator": "esbuild scripts/db/migrate.ts --bundle --platform=node --format=cjs --outfile=migrate-runner.cjs --external:pg-native",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
