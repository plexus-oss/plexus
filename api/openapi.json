    "/v1/sources/{source_id}/metrics/query": {
      "get": {
        "tags": [
          "metrics"
        ],
        "summary": "Query Metrics",
        "description": "Return historical time-series for one or more metrics with auto-downsampling.\n\nSource: ClickHouse \u2014 raw rows for windows <10 min, pre-aggregated 1-min or\n1-hr buckets for longer windows. Latency: <5s. Response includes interval and\nauto_downsampled so callers know the resolution chosen.\nUse when: rendering charts or running analysis over a time range.\nFor live data use /stream instead.",
        "operationId": "query_metrics_v1_sources__source_id__metrics_query_get",
        "parameters": [
          {
            "name": "source_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Source Id"
            }
          },
          {
            "name": "metrics",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "comma-separated metric names; omit for all",
              "title": "Metrics"
            },
            "description": "comma-separated metric names; omit for all"
          },
          {
            "name": "last",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "e.g. 1h, 30m, 7d",
              "title": "Last"
            },
            "description": "e.g. 1h, 30m, 7d"
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ISO 8601 start time",
              "title": "Start"
            },
            "description": "ISO 8601 start time"
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ISO 8601 end time",
              "title": "End"
            },
            "description": "ISO 8601 end time"
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "raw|1m|10m|1h|1d; omit for auto",
              "title": "Interval"
            },
            "description": "raw|1m|10m|1h|1d; omit for auto"
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Api-Key"
