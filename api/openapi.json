        ],
        "summary": "List Metrics",
        "description": "Return distinct metric names ever reported by a device.\n\nSource: ClickHouse (telemetry_dist). Latency: <5s.\nUse when: populating a metric picker or checking what a device reports.\nNot suitable for checking current values \u2014 use /latest for that.",
        "operationId": "list_metrics_v1_sources__source_id__metrics_get",
        "parameters": [
          {
            "name": "source_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
