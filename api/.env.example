# Dev flags
DEV_MODE=false
DEV_ORG_ID=dev_org

# Postgres (existing deployment, data_api schema)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/plexus

# Redis (shared with gateway)
REDIS_URL=redis://localhost:6379

# ClickHouse (HTTP interface; prod uses port 8123 as telemetry_writer)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_SECURE=false
CLICKHOUSE_DATABASE=plexus
CLICKHOUSE_USER=telemetry_writer
CLICKHOUSE_PASSWORD=

# Gateway
GATEWAY_URL=ws://localhost:8080

# Auth cache TTLs in seconds
AUTH_CACHE_TTL=300
AUTH_NEGATIVE_CACHE_TTL=30
AUTH_DISABLED_CACHE_TTL=60

# Shared secret for internal-only routes (/health/system) and gateway command auth
INTERNAL_SECRET=

# Frontend app URL (used in billing/payment-required messages)
APP_URL=https://app.plexus.company

# Video live-stream proxy timeout in seconds (per-session override via ?timeout=)
VIDEO_STREAM_TIMEOUT=600
