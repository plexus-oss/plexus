# .env.deploy — Production secrets for deploy.sh
#
# Copy this file to `.env.deploy` (gitignored) and fill in real values.
# `./deploy.sh secrets` reads this file and sets each line as a `fly secrets`.
#
# These become `fly secrets` on the plexus-gateway app — they are never
# committed to the repo and never end up in fly.toml.

# Where the gateway talks to Redis over Fly's private 6PN network.
# This value is stable — it's the DNS name of the redis sidecar app.
REDIS_URL=plexus-gateway-redis.internal:6379

# Next.js API URL used to verify API keys and session tokens.
PLEXUS_API_URL=https://app.plexus.company

# Comma-separated list of Origin headers allowed on the browser WebSocket.
# Glob patterns supported (e.g. "*.plexus.company").
GATEWAY_ALLOWED_ORIGINS=app.plexus.company,*.plexus.company
