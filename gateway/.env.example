# Plexus Gateway — environment configuration
#
# Copy this file to `.env` (gitignored) and fill in values as needed.
# Loaded automatically by main.go via godotenv if present.
# In prod (Fly.io), these are set as `fly secrets` — no .env file exists.
#
# Precedence at runtime: CLI flags > env vars > mode defaults.
# See gateway_config.go for the full list of defaults.

# -----------------------------------------------------------------------------
# Mode
# -----------------------------------------------------------------------------

# dev  — local defaults, auth skipped, DevOrg used for everything.
# prod — env-var driven, calls PLEXUS_API_URL to verify keys/sessions.
GATEWAY_MODE=dev

# Listen address for HTTP/WebSocket server.
GATEWAY_ADDR=:8080

# Log level: debug | info | warn | error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# Redis address in host:port form.
# Local dev: localhost:6379 (matches docker-compose.yml).
# Prod (same-box):   localhost:6379
# Prod (Fly Upstash): plexus-redis.internal:6379
REDIS_URL=localhost:6379

# Optional: connection pool size (default 10).
# REDIS_POOL_SIZE=10

# Optional: XADD MAXLEN ~ cap on telemetry.stream:{org} (default 100000).
# REDIS_STREAM_MAX_LEN=100000

# -----------------------------------------------------------------------------
# Auth (prod mode only)
# -----------------------------------------------------------------------------

# Next.js API URL used to verify device API keys and browser session tokens.
# Required when GATEWAY_MODE=prod. Ignored in dev mode.
PLEXUS_API_URL=https://app.plexus.company

# Comma-separated list of allowed Origin headers for the browser WebSocket.
# Required when GATEWAY_MODE=prod. Glob patterns supported
# (e.g. "*.plexus.company", "localhost:*").
# Not applied to the device WebSocket — API key auth is the gate there.
GATEWAY_ALLOWED_ORIGINS=app.plexus.company,localhost:*
