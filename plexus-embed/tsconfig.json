{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["../frontend/*"]
    },
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true
  },
  "include": ["src"]
}
