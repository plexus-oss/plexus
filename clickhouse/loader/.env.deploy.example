# .env.deploy — production secrets consumed by ./deploy.sh
#
# Copy to .env.deploy and fill in real values. This file is NOT committed;
# it's read by `./deploy.sh secrets` and pushed as Fly secrets via
# `fly secrets set`.
#
# Distinct from .env (which is for local compose dev). Keep them separate:
#   .env           — local Redis / compose-friendly values
#   .env.deploy    — real Fly secrets

# ── Redis ────────────────────────────────────────────────────────────────
# The loader scans this Redis for `telemetry.stream:*` keys and consumes
# via a shared ch-loader consumer group. Fly 6PN internal DNS — both
# plexus-ch-loader and gateway-redis must be in the same Fly org
# (plexus-725).
REDIS_URL=redis://plexus-gateway-redis.internal:6379

# ── ClickHouse auth ──────────────────────────────────────────────────────
# Plaintext password for telemetry_writer; must hash to the server's
# CH_WRITER_PASSWORD_SHA256 secret (users.xml resolves hashes via from_env=)
# and match the CH_PASSWORD secret set on plexus-ch itself. Never commit
# the real value.
CH_PASSWORD=

# ── Recording filter (Next.js bootstrap + push) ──────────────────────────
# Required in prod. Loader fetches recording-enabled sources at startup and
# receives push updates via POST /recording when config.recording changes.
# If unset, filter is disabled — all sources are persisted (dev/no-filter mode).
# Same values as PLEXUS_API_URL / PLEXUS_INTERNAL_SECRET on the alert-service.
PLEXUS_API_URL=https://app.plexus.company
PLEXUS_INTERNAL_SECRET=change-me
