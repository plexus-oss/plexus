# ── Redis ────────────────────────────────────────────────────────────────
# The loader scans this Redis for all `telemetry.stream:*` keys and
# consumes them via a shared ch-loader consumer group.
#   Prod:              redis://plexus-gateway-redis.internal:6379
#   Local w/ compose:  redis://loader-redis:6379    (docker compose --profile local-redis up)
#   Local w/ host:     redis://host.docker.internal:6379
REDIS_URL=redis://plexus-gateway-redis.internal:6379

# ── ClickHouse target ────────────────────────────────────────────────────
# Host to write to. Loader writes via plexus.telemetry_dist so the
# Distributed engine routes each row to its owning shard by cityHash64(org_id).
# Any node in the cluster is a valid target.
#   Prod:              plexus-ch.internal       (Fly 6PN DNS)
#   Local w/ compose:  host.docker.internal     (server/ compose running on host)
#   Local sidecar:     ch-01                    (if sharing a docker network)
CH_HOST=plexus-ch.internal

# Plaintext password for telemetry_writer; must match server's CH_PASSWORD
# (i.e. it must hash to the server's CH_WRITER_PASSWORD_SHA256:
#   printf %s "$PASSWORD" | shasum -a 256 | cut -d' ' -f1     # macOS
#   printf %s "$PASSWORD" | sha256sum | cut -d' ' -f1         # Linux
# ). Never commit the real value.
CH_PASSWORD=

# ── Scaling (only set when running >1 replica) ───────────────────────────
# CONSUMER_NAME=                   # default: loader-0; must be unique per replica

# ── Recording filter (Next.js bootstrap + push) ──────────────────────────
# REQUIRED: the loader refuses to boot without both. It fetches
# recording-enabled sources at startup and receives push updates via
# POST /recording when config.recording changes; the secret authenticates
# both directions (x-internal-secret).
# PLEXUS_API_URL=https://app.plexus.so
# PLEXUS_INTERNAL_SECRET=...
#
# Dev-only escape hatch: boot without the two vars above. Disables the
# filter (ALL sources persisted) and leaves POST /recording unauthenticated.
# RECORDING_FILTER_DISABLED=1

# ── Tuning (defaults almost always fine) ─────────────────────────────────
# CH_TABLE=plexus.telemetry_dist          # where rows go; _dist fans out to shards
# BATCH_SIZE=5000                         # total messages per xreadgroup call
# BATCH_INTERVAL=2.0                      # seconds to block waiting for data
# STREAM_DISCOVERY_INTERVAL=60            # seconds between Redis telemetry.stream:* rescans
# HEALTH_PORT=8080                        # health check listener
