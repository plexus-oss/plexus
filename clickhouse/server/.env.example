# ── ClickHouse auth ──────────────────────────────────────────────────────
# users.xml resolves all password hashes from the environment via from_env=.
# Generate each hash from its plaintext:
#   macOS:  printf %s "$PASSWORD" | shasum -a 256 | cut -d' ' -f1
#   Linux:  printf %s "$PASSWORD" | sha256sum | cut -d' ' -f1
# Keep the plaintexts in your password manager only — never commit them.

# sha256 of the telemetry_writer plaintext (loader ingest path).
CH_WRITER_PASSWORD_SHA256=

# sha256 of the nextjs_reader plaintext (app read path).
CH_READER_PASSWORD_SHA256=

# sha256 of the admin plaintext (human operator / schema author).
CH_ADMIN_PASSWORD_SHA256=

# Plaintext password for telemetry_writer. Must hash to
# CH_WRITER_PASSWORD_SHA256 above; referenced by config.xml's
# <remote_servers> replica credentials via from_env=.
# The loader uses the same plaintext as its CH_PASSWORD secret.
CH_PASSWORD=

# Inter-node replication secret used by <remote_servers><secret/>.
# Only exercised with 2+ CH nodes, but referenced from config.xml so it
# must be set or CH will fail startup XML resolution.
CH_REPLICATION_SECRET=change-me

# ── Tigris S3 (cold storage + backups, single bucket) ───────────────────
# Create one bucket:  fly storage create plexus-ch
# Cold and backup live under separate prefixes so lifecycle rules can
# target them independently. Endpoints must end with /.
#
# Credential names match what `fly storage create` provisions so the
# same disks.xml works for both compose and Fly without renaming.
#
# Optional for local dev: leave blank if you only create tables on
# storage_policy='default'. Required in prod once any table uses
# storage_policy='tiered' or 's3_only'. For local Minio, use something
# like minioadmin / minioadmin and host.docker.internal:9100 endpoints.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLICKHOUSE_S3_COLD_ENDPOINT=https://fly.storage.tigris.dev/plexus-ch/clickhouse/cold_storage/
CLICKHOUSE_S3_BACKUP_ENDPOINT=https://fly.storage.tigris.dev/plexus-ch/clickhouse/backups/
