# .env.deploy — production secrets consumed by ./deploy.sh
#
# Copy to .env.deploy and fill in real values. This file is NOT committed;
# it's read by `./deploy.sh secrets` (and implicitly by `init` / `schema`)
# and pushed as Fly secrets via `fly secrets set`.
#
# Distinct from .env (which is for local compose dev). Keep them separate:
#   .env           — local Minio / compose-friendly values
#   .env.deploy    — real Fly secrets

# Plaintext for telemetry_writer. Must hash to CH_WRITER_PASSWORD_SHA256
# below (users.xml resolves hashes via from_env=). Never commit the real value.
CH_PASSWORD=

# sha256 hashes for the three users in configs/clickhouse/users.xml.
# Generate: printf %s "$PASSWORD" | shasum -a 256 | cut -d' ' -f1   (macOS)
#           printf %s "$PASSWORD" | sha256sum | cut -d' ' -f1       (Linux)
CH_WRITER_PASSWORD_SHA256=
CH_READER_PASSWORD_SHA256=
CH_ADMIN_PASSWORD_SHA256=

# Inter-node replication secret. Referenced by config.xml via from_env=
# so CH fails XML resolution at startup if unset. Exercised only with 2+
# nodes; pick any strong random string. Suggested: `openssl rand -hex 32`
CH_REPLICATION_SECRET=change-me-to-a-real-random-hex-string
